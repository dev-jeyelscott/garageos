{
  "name": "garageos",
  "private": true,
  "version": "0.0.0",
  "description": "GarageOS - Motorcycle Shop Management System SaaS",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "audit:deps": "pnpm audit --audit-level high",
    "bash:run-checks": "bash .bash/scripts/run-checks.sh",
    "prepare-commit": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:migrate && pnpm db:validate",
    "db:migrate": "node packages/db/scripts/validate-migration-order.cjs && node-pg-migrate up --migrations-dir packages/db/migrations --migrations-table schema_migrations",
    "db:migrate:down": "node-pg-migrate down --migrations-dir packages/db/migrations --migrations-table schema_migrations",
    "db:migration:new": "node packages/db/scripts/create-migration.cjs",
    "db:migrate:create": "node packages/db/scripts/create-migration.cjs",
    "db:migrate:validate": "echo \"Migration validation placeholder: no migrations exist yet. Replace in Milestone 1.\"",
    "db:seed": "pnpm --filter @garageos/db seed",
    "bootstrap:platform-admin": "dotenv -e .env -- pnpm --filter @garageos/api bootstrap:platform-admin",
    "db:validate": "pnpm --filter @garageos/db validate",
    "dev:web": "pnpm --filter @garageos/web dev",
    "dev:api": "dotenv -e .env -- pnpm --filter @garageos/api dev",
    "dev:worker": "pnpm --filter @garageos/worker dev",
    "dev:scheduler": "pnpm --filter @garageos/scheduler dev",
    "start:web": "pnpm --filter @garageos/web start",
    "start:api": "dotenv -e .env -- pnpm --filter @garageos/api start",
    "start:worker": "pnpm --filter @garageos/worker start",
    "start:scheduler": "pnpm --filter @garageos/scheduler start",
    "dev:db": "docker compose up -d postgres",
    "dev:db:down": "docker compose down",
    "dev:db:reset": "docker compose down -v && docker compose up -d postgres",
    "dev:db:logs": "docker compose logs -f postgres",
    "validate:quick": "pnpm format:check && pnpm lint && pnpm typecheck",
    "validate:web": "pnpm --filter @garageos/web lint && pnpm --filter @garageos/web typecheck && pnpm --filter @garageos/web test",
    "validate:api": "pnpm --filter @garageos/api lint && pnpm --filter @garageos/api typecheck && pnpm --filter @garageos/api test",
    "validate:db": "node packages/db/scripts/validate-migration-order.cjs && pnpm db:validate",
    "validate:security": "pnpm --dir apps/api test:security && pnpm audit --audit-level high",
    "validate:e2e": "pnpm test:e2e",
    "validate:full": "pnpm validate:quick && pnpm validate:web && pnpm validate:api && pnpm validate:db && pnpm validate:security && pnpm validate:e2e",
    "validate:pr-evidence": "node ./.github/scripts/validate-pr-evidence.cjs",
    "test:pr-evidence": "node ./.github/scripts/validate-pr-evidence.test.cjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "node-pg-migrate": "^8.0.4",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
