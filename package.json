{
  "name": "garageos",
  "private": true,
  "version": "0.0.0",
  "description": "GarageOS - Motorcycle Shop Management System SaaS",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "audit:deps": "corepack pnpm audit --audit-level high",
    "bash:run-checks": "bash .bash/scripts/run-checks.sh",
    "bootstrap:platform-admin": "dotenv -e .env -- corepack pnpm --filter @garageos/api bootstrap:platform-admin",
    "db:migrate": "node packages/db/scripts/validate-migration-order.cjs && node-pg-migrate up --migrations-dir packages/db/migrations --migrations-table schema_migrations",
    "db:migrate:create": "node packages/db/scripts/create-migration.cjs",
    "db:migrate:down": "node-pg-migrate down --migrations-dir packages/db/migrations --migrations-table schema_migrations",
    "db:migrate:validate": "echo \"Migration validation placeholder: no migrations exist yet. Replace in Milestone 1.\"",
    "db:migration:new": "node packages/db/scripts/create-migration.cjs",
    "db:seed": "corepack pnpm --filter @garageos/db seed",
    "db:validate": "corepack pnpm --filter @garageos/db validate",
    "dev:api": "dotenv -e .env -- corepack pnpm --filter @garageos/api dev",
    "dev:db": "docker compose up -d postgres",
    "dev:db:down": "docker compose down",
    "dev:db:logs": "docker compose logs -f postgres",
    "dev:db:reset": "docker compose down -v && docker compose up -d postgres",
    "dev:scheduler": "corepack pnpm --filter @garageos/scheduler dev",
    "dev:web": "corepack pnpm --filter @garageos/web dev",
    "dev:worker": "corepack pnpm --filter @garageos/worker dev",
    "eng-loop:claim": "node ./.github/scripts/eng-loop-runner.cjs --mode=claim",
    "eng-loop:codex-pr:test": "node ./.github/scripts/eng-loop-codex-pr-automation.test.cjs",
    "eng-loop:dry-run": "node ./.github/scripts/eng-loop-runner.cjs --mode=dry-run",
    "eng-loop:first-5": "node ./.github/scripts/eng-loop-codex-pr-automation.cjs --mode=live --limit=5 --confirm-codex-pr",
    "eng-loop:first-5:claim": "node ./.github/scripts/eng-loop-runner.cjs --mode=first-5 --confirm-first-5",
    "eng-loop:first-5:dry-run": "node ./.github/scripts/eng-loop-codex-pr-automation.cjs --mode=dry-run --limit=5",
    "eng-loop:follow-up": "node ./.github/scripts/eng-loop-follow-up-task.cjs",
    "eng-loop:follow-up:test": "node ./.github/scripts/eng-loop-follow-up-task.test.cjs",
    "eng-loop:complete-merged-pr": "node ./.github/scripts/eng-loop-merged-pr-completion.cjs",
    "eng-loop:prepare-pr": "node ./.github/scripts/eng-loop-pr-automation.cjs",
    "eng-loop:task-scope:test": "node ./.github/scripts/eng-loop-task-scope.test.cjs",
    "eng-loop:test": "node ./.github/scripts/eng-loop-runner.test.cjs && node ./.github/scripts/eng-loop-pr-automation.test.cjs && node ./.github/scripts/eng-loop-follow-up-task.test.cjs && node ./.github/scripts/eng-loop-workflow-preflight.test.cjs && node ./.github/scripts/eng-loop-codex-pr-automation.test.cjs && node ./.github/scripts/eng-loop-task-scope.test.cjs && node ./.github/scripts/pr-merge-gate.test.cjs && node ./.github/scripts/pr-guarded-merge.test.cjs && node ./.github/scripts/eng-loop-merged-pr-completion.test.cjs && node ./.github/scripts/pr-risk-classifier.test.cjs && node ./.github/scripts/pr-ai-review.test.cjs",
    "test:pr-ai-review": "node ./.github/scripts/pr-ai-review.test.cjs",
    "test:pr-risk-classifier": "node ./.github/scripts/pr-risk-classifier.test.cjs",
    "eng-loop:validate": "node ./.github/scripts/eng-loop-validation-executor.cjs",
    "eng-loop:validation-executor:test": "node --test ./.github/scripts/eng-loop-validation-executor.test.cjs",
    "eng-loop:workflow-preflight:test": "node ./.github/scripts/eng-loop-workflow-preflight.test.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "corepack pnpm -r lint",
    "prepare": "husky",
    "prepare-commit": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm db:migrate && corepack pnpm db:validate",
    "start:api": "dotenv -e .env -- corepack pnpm --filter @garageos/api start",
    "start:scheduler": "corepack pnpm --filter @garageos/scheduler start",
    "start:web": "corepack pnpm --filter @garageos/web start",
    "start:worker": "corepack pnpm --filter @garageos/worker start",
    "test": "corepack pnpm -r test",
    "test:e2e": "playwright test",
    "test:eng-loop": "node --test ./.github/scripts/tests/run-engineering-loop-dry-run.test.cjs",
    "test:pr-evidence": "node ./.github/scripts/validate-pr-evidence.test.cjs",
    "test:watch": "corepack pnpm -r test:watch",
    "typecheck": "corepack pnpm -r typecheck",
    "validate:api": "corepack pnpm --filter @garageos/api lint && corepack pnpm --filter @garageos/api typecheck && corepack pnpm --filter @garageos/api test",
    "validate:db": "node packages/db/scripts/validate-migration-order.cjs && corepack pnpm db:validate",
    "validate:e2e": "corepack pnpm test:e2e",
    "validate:full": "corepack pnpm validate:quick && corepack pnpm validate:web && corepack pnpm validate:api && corepack pnpm validate:db && corepack pnpm validate:security && corepack pnpm validate:e2e",
    "validate:observability": "node ./.github/scripts/validate-observability-profile.cjs",
    "validate:pr-evidence": "node ./.github/scripts/validate-pr-evidence.cjs",
    "validate:quick": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck",
    "validate:security": "corepack pnpm --dir apps/api test:security && corepack pnpm audit --audit-level high",
    "validate:web": "corepack pnpm --filter @garageos/web lint && corepack pnpm --filter @garageos/web typecheck && corepack pnpm --filter @garageos/web test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "node-pg-migrate": "^8.0.4",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
